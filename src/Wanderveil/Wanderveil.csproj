<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.0.1</Version>
    <Author>Wrepsk</Author>
    <Name>Wanderveil</Name>
    <InternalName>Wanderveil</InternalName>
    <AssemblyName>Wanderveil</AssemblyName>
    <RootNamespace>Wanderveil</RootNamespace>
    <Punchline>Every place has a story. Leave yours.</Punchline>
    <Description>An adventurer's passport and discovery journal for Eorzea.
Early development build: a Passport for each of your characters, whose identity pages you fill in yourself, demo Discover cards/details, a Studio draft preview, an Echoes sample dossier, navigation, and motion settings. Collecting the postcard's demo stamp lets you press it anywhere on your passport's stamp pages.
Each character signs in by putting a short code on its Lodestone profile: the plugin sends the character's name and home world to the Wanderveil server you choose, which reads the public Lodestone profile, and keeps your passport details in step with that server. Stamps, drawing, and your picture stay on this PC. No game password is ever asked for. Sharing and publishing are coming later.</Description>
    <RepoUrl>https://github.com/Wrepsk/Wanderveil-Client</RepoUrl>
    <Tags>exploration;passport;discoveries;journal</Tags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Plates generated from SVG by tools/passport-art: shared plates, then each edition's own (cover, crest, banner,
         map, open book) as <edition>-<plate>. Each plate also has .half/.quarter/.eighth copies; the client draws the
         copy nearest its screen size. -->
    <EmbeddedResource Include="../../assets/passport/vector/*.png" LogicalName="Wanderveil.Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/passport/vector/editions/eorzea/*.png" LogicalName="Wanderveil.Assets.eorzea-%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/passport/vector/editions/gridania/*.png" LogicalName="Wanderveil.Assets.gridania-%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/passport/vector/editions/uldah/*.png" LogicalName="Wanderveil.Assets.uldah-%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/passport/vector/editions/limsa/*.png" LogicalName="Wanderveil.Assets.limsa-%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/passport/vector/editions/ishgard/*.png" LogicalName="Wanderveil.Assets.ishgard-%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/passport/vector/editions/garlemald/*.png" LogicalName="Wanderveil.Assets.garlemald-%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/fonts/*.ttf" Exclude="../../assets/fonts/SourceSerif4-*.ttf" LogicalName="Wanderveil.Assets.%(Filename)%(Extension)" />
    <None Include="../../assets/fonts/CormorantGaramond-LICENSE.md" Link="CormorantGaramond-LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/fonts/Cinzel-LICENSE.md" Link="Cinzel-LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/fonts/CourierPrime-LICENSE.md" Link="CourierPrime-LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/fonts/Caveat-LICENSE.md" Link="Caveat-LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/passport/studies/gridania/PROVENANCE.md" Link="Gridania-Assets.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/passport/studies/gridania/generation-prompts.md" Link="Gridania-generation-prompts.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/passport/vector/PROVENANCE.md" Link="Passport-Vector-Assets.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/passport/PROVENANCE.md" Link="Passport-Assets.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/passport/generation-prompts.md" Link="generation-prompts.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
