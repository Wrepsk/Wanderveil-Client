<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>true</UseWindowsForms>
    <DalamudLibPath>$(appdata)/XIVLauncher/addon/Hooks/dev</DalamudLibPath>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime plates come from the SVG generator (tools/passport-art); remaining Gridania studies stay gallery-only. -->
    <None Include="../../assets/passport/vector/*.png" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/passport/vector/editions/gridania/*.png" Exclude="../../assets/passport/vector/editions/gridania/book-open*.png" Link="Assets/Studies/Gridania/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/passport/vector/editions/gridania/book-open*.png" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/passport/studies/gridania/*.png" Exclude="../../assets/passport/studies/gridania/cover.png;../../assets/passport/studies/gridania/banner.png;../../assets/passport/studies/gridania/map-overhead.png;../../assets/passport/studies/gridania/crest.png" Link="Assets/Studies/Gridania/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/fonts/*.ttf" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)/Dalamud.Bindings.ImGui.dll</HintPath>
    </Reference>
    <None Include="$(DalamudLibPath)/cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../src/Wanderveil/UI/Primitives/*.cs" Link="UI/Primitives/%(Filename)%(Extension)" />
    <Compile Include="../../src/Wanderveil/UI/BookShell*.cs" Link="UI/%(Filename)%(Extension)" />
    <Compile Include="../../src/Wanderveil/UI/Components/*.cs" Link="UI/Components/%(Filename)%(Extension)" />
    <Compile Include="../../src/Wanderveil/Features/Passport/*.cs" Link="Passport/%(Filename)%(Extension)" />
    <Compile Include="../../src/Wanderveil/Features/Discover/*.cs" Link="Discover/%(Filename)%(Extension)" />
    <Compile Include="../../src/Wanderveil/Features/Studio/*.cs" Link="Studio/%(Filename)%(Extension)" />
    <Compile Include="../../src/Wanderveil/Features/Echoes/*.cs" Link="Echoes/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
